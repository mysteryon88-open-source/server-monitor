# Server names and existing OpenSSH Host aliases are in servers.json.
# Default interface language: ru or en.
LANGUAGE=ru

# Local browser panel. The server binds only to 127.0.0.1.
PORT=8765

# Sampling interval in seconds.
INTERVAL=2

# Absolute Linux path on the filesystem to monitor.
DISK_PATH=/

# false: allow native SSH password/passphrase/host-key prompts in the console.
# true: non-interactive authentication only (configured keys or ssh-agent).
SSH_BATCH_MODE=false

# Optional custom OpenSSH config path. Leave empty for the normal user config.
# Windows backslashes are literal. Quotes may surround a path with spaces.
SSH_CONFIG=

# Optional local sources; both are disabled unless explicitly enabled.
# self monitors the computer running server.py (Windows or Linux).
MONITOR_SELF=false
# Discover only running WSL distributions at startup; never boot stopped ones.
WSL_AUTODETECT=false
